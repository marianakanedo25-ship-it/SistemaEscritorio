# Endereço do banco de dados da Neon (Dashboard da Neon → Connect → copiar a "connection string")
DATABASE_URL=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
# E-mail que poderá criar a primeira conta de administradora
ADMIN_EMAIL=seu-email@exemplo.com
# Opcional: uma frase secreta longa para as sessões de login
SESSION_SECRET=
